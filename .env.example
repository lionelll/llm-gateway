APP_NAME=LLM Gateway
APP_ENV=development
LOG_LEVEL=INFO

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://llm_gateway:llm_gateway@postgres:5432/llm_gateway
DATABASE_SYNC_URL=postgresql+psycopg://llm_gateway:llm_gateway@postgres:5432/llm_gateway
REDIS_URL=redis://redis:6379/0

# ---------- Secrets (CHANGE THESE IN PRODUCTION) ----------
GATEWAY_API_KEY_HASH_SECRET=change-me-in-production
JWT_SECRET=change-me-jwt-secret-in-production
PROVIDER_KEY_ENCRYPTION_SECRET=change-me-encryption-secret

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:8000/portal?payment=success
STRIPE_CANCEL_URL=http://localhost:8000/portal?payment=cancel

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Rate Limiting ----------
API_KEY_RATE_LIMIT_PER_MINUTE=60
IP_RATE_LIMIT_PER_MINUTE=120
AUTO_DISABLE_API_KEYS_ON_ZERO_BALANCE=true

# ---------- Provider Health ----------
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_COOLDOWN_SECONDS=60
DEFAULT_PROVIDER_TIMEOUT_SECONDS=30

# ---------- Mock / Seed ----------
ENABLE_MOCK_PROVIDER=true
DEFAULT_MOCK_MODEL=gpt-4o-mini
SEED_ADMIN_API_KEY=gw_admin_local_key
SEED_GATEWAY_API_KEY=gw_demo_local_key
SEED_DEMO_PAYMENT_AMOUNT=200.00
SEED_DEMO_MARGIN_AMOUNT=40.00

# ---------- Seed Provider (optional) ----------
SEED_PROVIDER_NAME=
SEED_PROVIDER_TYPE=openai
SEED_PROVIDER_BASE_URL=
SEED_PROVIDER_API_KEY=
SEED_PROVIDER_SUPPORTED_MODELS=
SEED_PROVIDER_PRIORITY=50
SEED_PROVIDER_WEIGHT=10
SEED_PROVIDER_TIMEOUT_SECONDS=30
